{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 440,
  "height": 280,
  "config": {
    "background": "transparent",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "labelColor": "#53615c",
      "titleColor": "#53615c",
      "gridColor": "#e3e7e0",
      "domain": false,
      "tickColor": "#cbd3cb"
    },
    "legend": {
      "labelFontSize": 11,
      "title": null,
      "orient": "bottom",
      "symbolType": "circle"
    }
  },
  "data": {
    "url": "commodity_year.csv"
  },
  "transform": [
    {
      "filter": "datum.leading==1 && datum.year==2025"
    },
    {
      "lookup": "commodity",
      "from": {
        "data": {
          "values": [
            {
              "commodity": "Apples",
              "label_x": 3,
              "label_y": -5.5,
              "label_side": "left"
            },
            {
              "commodity": "Avocados",
              "label_x": -11.5,
              "label_y": 23.5,
              "label_side": "left"
            },
            {
              "commodity": "Bananas",
              "label_x": -5.3,
              "label_y": 3,
              "label_side": "right"
            },
            {
              "commodity": "Blueberries",
              "label_x": -5.3,
              "label_y": -1.5,
              "label_side": "right"
            },
            {
              "commodity": "Leafy salad vegetables",
              "label_x": 8,
              "label_y": 0.5,
              "label_side": "left"
            },
            {
              "commodity": "Nursery",
              "label_x": 7,
              "label_y": 6.5,
              "label_side": "left"
            },
            {
              "commodity": "Oranges",
              "label_x": 5.5,
              "label_y": 14.5,
              "label_side": "left"
            },
            {
              "commodity": "Potatoes",
              "label_x": -5.3,
              "label_y": 11,
              "label_side": "right"
            },
            {
              "commodity": "Table grapes",
              "label_x": 22.638133,
              "label_y": 19,
              "label_side": "center"
            },
            {
              "commodity": "Tomatoes",
              "label_x": -5.3,
              "label_y": 7,
              "label_side": "right"
            }
          ]
        },
        "key": "commodity",
        "fields": [
          "label_x",
          "label_y",
          "label_side"
        ]
      }
    },
    {
      "calculate": "datum.display=='Salad vegetables' ? 'Salad\\nvegetables' : datum.display",
      "as": "industry_label"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "zero": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#b3bdb2"
      },
      "encoding": {
        "x": {
          "field": "zero",
          "type": "quantitative",
          "title": "Physical output change (%)",
          "axis": {
            "title": "Physical output change (%)",
            "format": ".0f",
            "values": [
              -20,
              -10,
              0,
              10,
              20,
              30
            ],
            "labelOverlap": false
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "zero": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#b3bdb2"
      },
      "encoding": {
        "y": {
          "field": "zero",
          "type": "quantitative",
          "title": "Production value change (%)",
          "axis": {
            "title": "Production value change (%)",
            "format": ".0f"
          }
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#87958a",
        "strokeWidth": 0.8,
        "opacity": 0.8
      },
      "encoding": {
        "x": {
          "field": "volume_growth",
          "type": "quantitative"
        },
        "y": {
          "field": "value_growth",
          "type": "quantitative"
        },
        "x2": {
          "field": "label_x"
        },
        "y2": {
          "field": "label_y"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "volume_growth",
          "type": "quantitative",
          "title": "Physical output change (%)",
          "scale": {
            "domain": [
              -24,
              36
            ],
            "nice": false
          },
          "axis": {
            "title": "Physical output change (%)",
            "format": ".0f",
            "values": [
              -20,
              -10,
              0,
              10,
              20,
              30
            ],
            "labelOverlap": false
          }
        },
        "y": {
          "field": "value_growth",
          "type": "quantitative",
          "title": "Production value change (%)",
          "scale": {
            "domain": [
              -9,
              30
            ]
          },
          "axis": {
            "title": "Production value change (%)",
            "format": ".0f"
          }
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Fruit",
              "Vegetables",
              "Nursery"
            ],
            "range": [
              "#c7652a",
              "#276f8a",
              "#527647"
            ]
          },
          "legend": {
            "columns": 3,
            "columnPadding": 8,
            "symbolSize": 60
          }
        },
        "tooltip": [
          {
            "field": "display",
            "type": "nominal",
            "title": "Industry"
          },
          {
            "field": "volume_growth",
            "type": "quantitative",
            "title": "Output change (%)",
            "format": "+.1f"
          },
          {
            "field": "value_growth",
            "type": "quantitative",
            "title": "Value change (%)",
            "format": "+.1f"
          },
          {
            "field": "volume_unit",
            "type": "nominal",
            "title": "Output measured in"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.label_side=='left'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
        "dy": 0,
        "fontSize": 11,
        "color": "#203b2f",
        "lineBreak": "\n",
        "lineHeight": 12
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "industry_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.label_side=='right'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -4,
        "dy": 0,
        "fontSize": 11,
        "color": "#203b2f",
        "lineBreak": "\n",
        "lineHeight": 12
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "industry_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.label_side=='center'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "dx": 0,
        "dy": -4,
        "fontSize": 11,
        "color": "#203b2f",
        "lineBreak": "\n",
        "lineHeight": 12
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "industry_label",
          "type": "nominal"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  }
}
