{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 440,
  "height": 280,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "labelColor": "#53615c",
      "titleColor": "#53615c",
      "gridColor": "#e3e7e0",
      "domain": false,
      "tickColor": "#cbd3cb"
    },
    "legend": {
      "labelFontSize": 11,
      "title": null,
      "orient": "bottom",
      "symbolType": "circle"
    }
  },
  "data": {
    "url": "sector_year.csv"
  },
  "params": [
    {
      "name": "measure",
      "value": "value_index",
      "bind": {
        "input": "select",
        "options": [
          "value_index",
          "volume_index"
        ],
        "labels": [
          "Production value",
          "Physical output"
        ],
        "name": "Compare: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum[measure]",
      "as": "index"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "baseline": 100
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#9aa99b"
      },
      "encoding": {
        "y": {
          "field": "baseline",
          "type": "quantitative",
          "title": "Index (2020/21 = 100)",
          "axis": {
            "title": "Index (2020/21 = 100)"
          }
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 48
        },
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "title": null,
          "sort": [
            "2020/21",
            "2021/22",
            "2022/23",
            "2023/24",
            "2024/25"
          ],
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "index",
          "type": "quantitative",
          "title": "Index (2020/21 = 100)",
          "scale": {
            "domain": [
              75,
              135
            ],
            "zero": false
          },
          "axis": {
            "title": "Index (2020/21 = 100)"
          }
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Fruit",
              "Vegetables",
              "Nursery"
            ],
            "range": [
              "#c7652a",
              "#276f8a",
              "#527647"
            ]
          },
          "legend": {}
        },
        "tooltip": [
          {
            "field": "sector",
            "type": "nominal",
            "title": "Sector"
          },
          {
            "field": "period",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "value_m",
            "type": "quantitative",
            "title": "Production value (AUD million)",
            "format": ",.1f"
          },
          {
            "field": "volume",
            "type": "quantitative",
            "title": "Physical output",
            "format": ",.0f"
          },
          {
            "field": "volume_unit",
            "type": "nominal",
            "title": "Output unit"
          },
          {
            "field": "index",
            "type": "quantitative",
            "title": "Index",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  }
}
