{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 440,
  "height": 335,
  "padding": 8,
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "background": "transparent",
  "config": {
    "font": "Arial"
  },
  "data": [
    {
      "name": "tree",
      "url": "treemap_data.json",
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "method": "squarify",
          "ratio": 1.4,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 3,
          "paddingOuter": 2,
          "round": true
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        },
        {
          "type": "formula",
          "expr": "split(datum.name, ' ')",
          "as": "labelLines"
        },
        {
          "type": "formula",
          "expr": "datum.x1-datum.x0 < 50 && datum.y1-datum.y0 > datum.x1-datum.x0",
          "as": "rotateLabel"
        },
        {
          "type": "formula",
          "expr": "datum.rotateLabel ? datum.y1-datum.y0 : datum.x1-datum.x0",
          "as": "labelWidth"
        },
        {
          "type": "formula",
          "expr": "datum.rotateLabel ? datum.x1-datum.x0 : datum.y1-datum.y0",
          "as": "labelHeight"
        },
        {
          "type": "formula",
          "expr": "min(14, (datum.labelWidth-8)/(0.65*max(length(datum.labelLines[0]),length(datum.labelLines[1] || ''))), (datum.labelHeight-6)/(length(datum.labelLines)*1.2))",
          "as": "labelFont"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "sector",
      "type": "ordinal",
      "domain": [
        "Fruit",
        "Vegetables",
        "Nursery"
      ],
      "range": [
        "#c7652a",
        "#276f8a",
        "#527647"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "sector",
            "field": "sector"
          },
          "fillOpacity": {
            "value": 0.9
          },
          "stroke": {
            "value": "#fafbf5"
          },
          "tooltip": {
            "signal": "{'Industry':datum.name,'Sector':datum.sector,'AUD million':format(datum.value,',.1f'),'Year':'2024/25'}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2 - (datum.rotateLabel ? (length(datum.labelLines)-1)*datum.labelFont*0.6 : 0)"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2 - (datum.rotateLabel ? 0 : (length(datum.labelLines)-1)*datum.labelFont*0.6)"
          },
          "text": {
            "field": "labelLines"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "white"
          },
          "fontSize": {
            "field": "labelFont"
          },
          "fontWeight": {
            "value": "bold"
          },
          "tooltip": {
            "signal": "{'Industry':datum.name,'Sector':datum.sector,'AUD million':format(datum.value,',.1f'),'Year':'2024/25'}"
          },
          "lineHeight": {
            "signal": "datum.labelFont*1.2"
          },
          "angle": {
            "signal": "datum.rotateLabel ? -90 : 0"
          }
        }
      }
    }
  ]
}
