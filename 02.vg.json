{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 440,
  "height": 335,
  "padding": 8,
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "background": "transparent",
  "config": {
    "font": "Arial"
  },
  "data": [
    {
      "name": "tree",
      "url": "treemap_data.json",
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "method": "squarify",
          "ratio": 1.4,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 3,
          "paddingOuter": 2,
          "round": true
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        },
        {
          "type": "formula",
          "expr": "indexof([\"Fruit:Table grapes\", \"Fruit:Bananas\", \"Fruit:Avocados\", \"Fruit:Apples\", \"Fruit:Oranges\", \"Fruit:rest\", \"Vegetables:Potatoes\", \"Vegetables:Leafy salad vegetables\", \"Vegetables:Tomatoes\", \"Vegetables:Mushrooms\", \"Vegetables:Parsley and other fresh herbs excluding fennel\", \"Vegetables:rest\", \"Nursery:Nursery\"], datum.id)+1",
          "as": "keyNumber"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "sector",
      "type": "ordinal",
      "domain": [
        "Fruit",
        "Vegetables",
        "Nursery"
      ],
      "range": [
        "#c7652a",
        "#276f8a",
        "#527647"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "sector",
            "field": "sector"
          },
          "fillOpacity": {
            "value": 0.9
          },
          "stroke": {
            "value": "#fafbf5"
          },
          "tooltip": {
            "signal": "{'Industry':datum.name,'Sector':datum.sector,'AUD million':format(datum.value,',.1f'),'Year':'2024/25'}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2"
          },
          "text": {
            "signal": "format(datum.keyNumber,'02d')"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "white"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "tooltip": {
            "signal": "{'Industry':datum.name,'Sector':datum.sector,'AUD million':format(datum.value,',.1f'),'Year':'2024/25'}"
          }
        }
      }
    }
  ]
}
