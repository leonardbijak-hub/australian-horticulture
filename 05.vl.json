{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 440,
  "height": 395,
  "config": {
    "background": "transparent",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "labelColor": "#53615c",
      "titleColor": "#53615c",
      "gridColor": "#e3e7e0",
      "domain": false,
      "tickColor": "#cbd3cb"
    },
    "legend": {
      "labelFontSize": 11,
      "title": null,
      "orient": "bottom",
      "symbolType": "circle"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "center": [
      0,
      -28
    ]
  },
  "params": [
    {
      "name": "stateSector",
      "value": "Fruit",
      "bind": {
        "input": "select",
        "options": [
          "Fruit",
          "Vegetables",
          "Nursery"
        ],
        "name": "Sector: "
      }
    },
    {
      "name": "mapYear",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [
          2021,
          2022,
          2023,
          2024,
          2025
        ],
        "labels": [
          "2020/21",
          "2021/22",
          "2022/23",
          "2023/24",
          "2024/25"
        ],
        "name": "Year: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "australia.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8ece2",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "state_sector_year.csv"
      },
      "transform": [
        {
          "filter": "datum.sector==stateSector && datum.year==mapYear"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "#fff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative",
          "title": null
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative",
          "title": null
        },
        "size": {
          "field": "value_m",
          "type": "quantitative",
          "title": "AUD million",
          "scale": {
            "domain": [
              0,
              3100
            ],
            "range": [
              0,
              7300
            ]
          },
          "legend": {
            "orient": "bottom",
            "values": [
              100,
              1000,
              2500
            ],
            "symbolFillColor": {
              "expr": "stateSector=='Fruit' ? '#c7652a' : stateSector=='Vegetables' ? '#276f8a' : '#527647'"
            },
            "symbolStrokeColor": "white"
          }
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Fruit",
              "Vegetables",
              "Nursery"
            ],
            "range": [
              "#c7652a",
              "#276f8a",
              "#527647"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "sector",
            "type": "nominal",
            "title": "Sector"
          },
          {
            "field": "period",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "value_m",
            "type": "quantitative",
            "title": "Production value (AUD million)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "New South Wales",
            "lon": 146.5,
            "lat": -32.2,
            "abbr": "NSW"
          },
          {
            "state": "Victoria",
            "lon": 144.9,
            "lat": -37.4,
            "abbr": "VIC"
          },
          {
            "state": "Queensland",
            "lon": 144.5,
            "lat": -22.8,
            "abbr": "QLD"
          },
          {
            "state": "South Australia",
            "lon": 135,
            "lat": -30.1,
            "abbr": "SA"
          },
          {
            "state": "Western Australia",
            "lon": 122.2,
            "lat": -25.5,
            "abbr": "WA"
          },
          {
            "state": "Tasmania",
            "lon": 146.7,
            "lat": -42,
            "abbr": "TAS"
          },
          {
            "state": "Northern Territory",
            "lon": 133.4,
            "lat": -19.5,
            "abbr": "NT"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": -5,
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#1b392f"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative",
          "title": null
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative",
          "title": null
        },
        "text": {
          "field": "abbr",
          "type": "nominal",
          "title": null
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  }
}
