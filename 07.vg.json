{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 440,
  "height": 420,
  "padding": 8,
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "background": "transparent",
  "config": {
    "font": "Source Sans 3",
    "text": {
      "font": "Source Sans 3"
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  },
  "signals": [
    {
      "name": "cartYear",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [
          2021,
          2022,
          2023,
          2024,
          2025
        ],
        "labels": [
          "2020/21",
          "2021/22",
          "2022/23",
          "2023/24",
          "2024/25"
        ],
        "name": "Year: "
      }
    }
  ],
  "data": [
    {
      "name": "states",
      "url": "cartogram_data.json",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.year==cartYear"
        }
      ]
    },
    {
      "name": "geography",
      "url": "australia.topojson",
      "format": {
        "type": "topojson",
        "feature": "states"
      }
    }
  ],
  "scales": [
    {
      "name": "area",
      "type": "linear",
      "domain": [
        0,
        850
      ],
      "range": [
        0,
        {
          "signal": "4*pow(85*width/500,2)"
        }
      ],
      "zero": true
    }
  ],
  "marks": [
    {
      "name": "geographicContext",
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "value": 4
          },
          "y": {
            "signal": "height-width*0.20-10"
          }
        }
      },
      "marks": [
        {
          "name": "referenceMap",
          "type": "shape",
          "from": {
            "data": "geography"
          },
          "transform": [
            {
              "type": "geoshape",
              "projection": "australia"
            }
          ],
          "encode": {
            "update": {
              "fill": {
                "value": "#e3e8df"
              },
              "stroke": {
                "value": "white"
              },
              "strokeWidth": {
                "value": 1
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": -22
              },
              "text": {
                "value": [
                  "Geographic",
                  "reference"
                ]
              },
              "lineHeight": {
                "value": 10
              },
              "fontSize": {
                "value": 9
              },
              "fill": {
                "value": "#5f6e61"
              }
            }
          }
        }
      ]
    },
    {
      "type": "symbol",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "fill": {
            "value": "#527647"
          },
          "fillOpacity": {
            "value": 0.88
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 2
          }
        },
        "update": {
          "x": {
            "signal": "datum.x*width"
          },
          "y": {
            "signal": "datum.y*width"
          },
          "size": {
            "scale": "area",
            "field": "value_m"
          },
          "tooltip": {
            "signal": "{'State':datum.state,'Financial year':datum.period,'AUD million':format(datum.value_m,',.1f')}"
          }
        }
      },
      "name": "nurseryCircles"
    },
    {
      "type": "text",
      "from": {
        "data": "states"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x*width"
          },
          "y": {
            "signal": "datum.y*width"
          },
          "text": {
            "field": "abbr"
          },
          "fontSize": {
            "signal": "width<350 ? 10 : 12"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "signal": "datum.value_m>100 && datum.abbr!='TAS' ? 'white' : '#20392d'"
          },
          "dy": {
            "signal": "datum.value_m>100 ? 3 : datum.abbr=='TAS' ? 3 : -sqrt(scale('area',datum.value_m)/4)-5"
          },
          "align": {
            "signal": "datum.abbr=='TAS' ? 'left' : 'center'"
          },
          "dx": {
            "signal": "datum.abbr=='TAS' ? sqrt(scale('area',datum.value_m)/4)+5 : 0"
          }
        }
      }
    }
  ],
  "legends": [
    {
      "size": "area",
      "title": "Production value (AUD million)",
      "orient": "bottom",
      "direction": "horizontal",
      "values": [
        25,
        100,
        250
      ],
      "symbolFillColor": "#527647",
      "titleFontSize": 10,
      "labelFontSize": 10,
      "titleLimit": 300
    }
  ],
  "projections": [
    {
      "name": "australia",
      "type": "conicEqualArea",
      "rotate": [
        -134,
        0,
        0
      ],
      "parallels": [
        -18,
        -36
      ],
      "center": [
        0,
        -28
      ],
      "fit": {
        "signal": "data('geography')"
      },
      "size": {
        "signal": "[width*0.28,width*0.20]"
      }
    }
  ],
  "description": "A Dorling cartogram: state circles replace geographic areas, with areas proportional to nursery production value. Collision displacement preserves approximate relative geography. A separate inset supplies geographic context."
}
