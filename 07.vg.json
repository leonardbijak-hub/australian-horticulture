{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 440,
  "height": 350,
  "padding": 8,
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "background": "transparent",
  "config": {
    "font": "Arial"
  },
  "signals": [
    {
      "name": "cartYear",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [
          2021,
          2022,
          2023,
          2024,
          2025
        ],
        "labels": [
          "2020/21",
          "2021/22",
          "2022/23",
          "2023/24",
          "2024/25"
        ],
        "name": "Year: "
      }
    },
    {
      "name": "legendX",
      "update": "max(34,width*0.14)"
    },
    {
      "name": "legendBase",
      "update": "height-10"
    },
    {
      "name": "legendRadius",
      "update": "sqrt(scale('area',800))/2"
    }
  ],
  "data": [
    {
      "name": "states",
      "url": "cartogram_data.json",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.year==cartYear"
        }
      ]
    },
    {
      "name": "summary",
      "source": "states",
      "transform": [
        {
          "type": "formula",
          "expr": "indexof(['NSW','QLD','VIC'],datum.abbr)>=0 ? datum.value_m : 0",
          "as": "major_value"
        },
        {
          "type": "aggregate",
          "fields": [
            "value_m",
            "major_value"
          ],
          "ops": [
            "sum",
            "sum"
          ],
          "as": [
            "total",
            "major"
          ]
        }
      ]
    },
    {
      "name": "referenceSizes",
      "values": [
        {
          "value": 800
        },
        {
          "value": 250
        },
        {
          "value": 50
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "area",
      "type": "linear",
      "domain": [
        0,
        850
      ],
      "range": [
        0,
        {
          "signal": "8168.5*pow(width/500,2)"
        }
      ],
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "symbol",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "fill": {
            "value": "#527647"
          },
          "fillOpacity": {
            "value": 0.88
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 2
          }
        },
        "update": {
          "x": {
            "signal": "datum.x*width"
          },
          "y": {
            "signal": "32+datum.y*(height-42)"
          },
          "size": {
            "scale": "area",
            "field": "value_m"
          },
          "tooltip": {
            "signal": "{'State':datum.state,'Financial year':datum.period,'AUD million':format(datum.value_m,',.1f')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "states"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x*width"
          },
          "y": {
            "signal": "32+datum.y*(height-42)"
          },
          "text": {
            "field": "abbr"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "signal": "sqrt(scale('area',datum.value_m))>=42 ? 'white' : '#20392d'"
          },
          "dy": {
            "signal": "sqrt(scale('area',datum.value_m))>=42 ? -5 : -sqrt(scale('area',datum.value_m))/2-20"
          },
          "align": {
            "value": "center"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "states"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x*width"
          },
          "y": {
            "signal": "32+datum.y*(height-42)"
          },
          "text": {
            "signal": "format(datum.value_m,',.1f')"
          },
          "fontSize": {
            "value": 10
          },
          "align": {
            "value": "center"
          },
          "fill": {
            "signal": "sqrt(scale('area',datum.value_m))>=42 ? 'white' : '#53615c'"
          },
          "dy": {
            "signal": "sqrt(scale('area',datum.value_m))>=42 ? 10 : -sqrt(scale('area',datum.value_m))/2-7"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "summary"
      },
      "encode": {
        "update": {
          "x": {
            "value": 8
          },
          "y": {
            "value": 12
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#20392d"
          },
          "text": {
            "signal": "length(data('states')) ? data('states')[0].period+' \u00b7 Top three: '+format(datum.major/datum.total,'.0%') : ''"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 8
          },
          "y": {
            "signal": "legendBase-2*legendRadius-16"
          },
          "text": {
            "value": "AUD million"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#53615c"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "referenceSizes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "legendX"
          },
          "y": {
            "signal": "legendBase-sqrt(scale('area',datum.value))/2"
          },
          "size": {
            "scale": "area",
            "field": "value"
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "#527647"
          },
          "strokeWidth": {
            "value": 1.2
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "referenceSizes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "legendX"
          },
          "x2": {
            "signal": "legendX+legendRadius+10"
          },
          "y": {
            "signal": "legendBase-sqrt(scale('area',datum.value))"
          },
          "stroke": {
            "value": "#879a7e"
          },
          "strokeWidth": {
            "value": 0.7
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "referenceSizes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "legendX+legendRadius+14"
          },
          "y": {
            "signal": "legendBase-sqrt(scale('area',datum.value))"
          },
          "text": {
            "signal": "format(datum.value,',.0f')"
          },
          "fontSize": {
            "value": 10
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#53615c"
          }
        }
      }
    }
  ]
}
