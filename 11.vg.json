    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "flows"
      },
      "encode": {
        "enter": {
          "fill": {
            "value": "#276f8a"
          },
          "fillOpacity": {
            "field": "opacity"
          },
          "tooltip": {
            "signal": "{'Destination':datum.name,'Tonnes':format(datum.tonnes,',.0f'),'Share of production':format(datum.share,'.1f')+'%'}"
          }
        },
        "update": {
          "path": {
            "signal": "'M'+width*.10+','+datum.sy+' C'+width*.38+','+datum.sy+' '+width*.43+','+datum.ty+' '+width*.68+','+datum.ty+' L'+width*.68+','+datum.ty2+' C'+width*.43+','+datum.ty2+' '+width*.38+','+datum.sy2+' '+width*.10+','+datum.sy2+' Z'"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "width*.08"
          },
          "x2": {
            "signal": "width*.10"
          },
          "y": {
            "value": 55
          },
          "y2": {
            "value": 295
          },
          "fill": {
            "value": "#276f8a"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width*.08"
          },
          "y": {
            "value": 325
          },
          "text": {
            "value": "Australian production"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#274137"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width*.08"
          },
          "y": {
            "value": 343
          },
          "text": {
            "value": "1,493,725 tonnes"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#53615c"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "flows"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width*.68"
          },
          "x2": {
            "signal": "width*.70"
          },
          "y": {
            "field": "ty"
          },
          "y2": {
            "field": "ty2"
          },
          "fill": {
            "value": "#276f8a"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "flows"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width*.72"
          },
          "y": {
            "signal": "(datum.ty+datum.ty2)/2-5"
          },
          "text": {
            "field": "name"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#274137"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "flows"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width*.72"
          },
          "y": {
            "signal": "(datum.ty+datum.ty2)/2+13"
          },
          "text": {
            "signal": "format(datum.tonnes,',.0f')+' t ('+format(datum.share,'.1f')+'%)'"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#53615c"
          }
        }
      }
    }
  ]
}