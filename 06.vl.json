{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 440,
  "height": 330,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "labelColor": "#53615c",
      "titleColor": "#53615c",
      "gridColor": "#e3e7e0",
      "domain": false,
      "tickColor": "#cbd3cb"
    },
    "legend": {
      "labelFontSize": 11,
      "title": null,
      "orient": "bottom",
      "symbolType": "circle",
      "layout": {
        "bottom": {
          "direction": "vertical"
        }
      }
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "center": [
      0,
      -28
    ]
  },
  "params": [
    {
      "name": "yieldYear",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [
          2023,
          2024,
          2025
        ],
        "labels": [
          "2022/23",
          "2023/24",
          "2024/25"
        ],
        "name": "Year: "
      }
    }
  ],
  "data": {
    "url": "australia.topojson",
    "format": {
      "type": "topojson",
      "feature": "states"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "datum": "No estimate",
          "type": "nominal",
          "scale": {
            "domain": [
              "No estimate"
            ],
            "range": [
              "#dfe4da"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "symbolType": "square"
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "availability",
            "type": "nominal",
            "title": "Availability"
          }
        ]
      },
      "transform": [
        {
          "calculate": "'No estimate available'",
          "as": "availability"
        }
      ]
    },
    {
      "data": {
        "url": "avocado_year.csv"
      },
      "transform": [
        {
          "filter": "datum.year==yieldYear && datum.state!=\"Australia\""
        },
        {
          "filter": "isValid(datum.yield)"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "australia.topojson",
              "format": {
                "type": "topojson",
                "feature": "states"
              }
            },
            "key": "properties.state"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "yield",
          "type": "quantitative",
          "title": "Tonnes / bearing hectare",
          "scale": {
            "domain": [
              0,
              20
            ],
            "range": [
              "#ebf2f1",
              "#1b566e"
            ]
          },
          "legend": {
            "orient": "bottom",
            "titleLimit": 300,
            "gradientLength": {
              "expr": "min(220,width-20)"
            }
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "period",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "production_t",
            "type": "quantitative",
            "title": "Production (tonnes)",
            "format": ",.0f"
          },
          {
            "field": "bearing_ha",
            "type": "quantitative",
            "title": "Bearing area (hectares)",
            "format": ",.1f"
          },
          {
            "field": "yield",
            "type": "quantitative",
            "title": "Tonnes per bearing hectare",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "New South Wales",
            "lon": 146.5,
            "lat": -32.2,
            "abbr": "NSW"
          },
          {
            "state": "Victoria",
            "lon": 144.9,
            "lat": -37.4,
            "abbr": "VIC"
          },
          {
            "state": "Queensland",
            "lon": 144.5,
            "lat": -22.8,
            "abbr": "QLD"
          },
          {
            "state": "South Australia",
            "lon": 135,
            "lat": -30.1,
            "abbr": "SA"
          },
          {
            "state": "Western Australia",
            "lon": 122.2,
            "lat": -25.5,
            "abbr": "WA"
          },
          {
            "state": "Tasmania",
            "lon": 146.7,
            "lat": -42,
            "abbr": "TAS"
          },
          {
            "state": "Northern Territory",
            "lon": 133.4,
            "lat": -19.5,
            "abbr": "NT"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": 0,
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#1b392f"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative",
          "title": null
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative",
          "title": null
        },
        "text": {
          "field": "abbr",
          "type": "nominal",
          "title": null
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
